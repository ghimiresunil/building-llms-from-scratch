# Copy to .env (git-ignored). Dynaconf loads it before every post-training run.
#
# BLFS_<FIELD> overrides any field of any stage, above configs/*.toml and below the
# command line. Variables that don't apply to the stage you run are skipped.

# BLFS_ENV=smoke                 # use the [default.smoke] tables (tiny model, CPU)
# BLFS_DEVICE=cuda
# BLFS_LOG_LEVEL=DEBUG            # DEBUG | INFO | WARNING | ERROR | CRITICAL
# BLFS_AMP_DTYPE=bf16
# BLFS_USE_WANDB=true
# BLFS_WANDB_PROJECT=building-llms-from-scratch

# Read by wandb itself, not by the configs:
# WANDB_API_KEY=...
